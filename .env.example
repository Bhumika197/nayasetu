# ==============================================================================
# NYAYASETU - Local Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to .env in each corresponding directory or at root:
#   backend/.env
#   ml-service/.env
#   frontend/.env
# NEVER commit .env files containing real passwords or secrets to Git.
# ==============================================================================

# --- Node.js Backend Configuration ---
PORT=5000
NODE_ENV=development
APP_SECRET=replace_with_a_secure_random_string_min_32_chars
SESSION_SECRET=replace_with_another_secure_random_string_32_chars
COOKIE_SECURE=false # Set to true in production (HTTPS)
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL Database Configuration ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nyayasetu
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nyayasetu

# --- Python ML Service Configuration ---
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_PORT=8000
ML_SERVICE_HOST=127.0.0.1

# --- Document Storage Paths (Local Private Storage) ---
UPLOAD_STORAGE_PATH=./storage/private/documents
QUARANTINE_STORAGE_PATH=./storage/private/quarantine

# --- External Open Data APIs (Strictly Optional / Fallback Included) ---
# Data.gov.in API Key (Optional - application runs offline with embedded seed data)
DATA_GOV_IN_API_KEY=
